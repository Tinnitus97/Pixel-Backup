<?xml version="1.0" encoding="utf-8"?>
<!--
  Feste Paketquelle für dieses Projekt.

  Ohne diese Datei gelten die Quellen des jeweiligen Rechners. Steht dort eine
  eigene Quelle (etwa MyGet), meldet Visual Studio bei jedem Paket „In dieser
  Quelle nicht verfügbar“ – die Avalonia-Pakete liegen auf nuget.org.
  <clear/> wirft die Rechnerquellen für dieses Projekt weg und nimmt nur die
  offizielle Quelle.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
