<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PixelBackup.App"
             x:Class="PixelBackup.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorderBrush">#E1E1E6</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorderBrush">#E1E1E6</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBackgroundBrush">#2A2A2E</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorderBrush">#3A3A42</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Grundmaß der Oberfläche. Kleiner als Avalonias Vorgabe (14), damit auf
         ein Fenster von 1180x720 spürbar mehr passt, ohne dass es gedrängt wirkt. -->
    <Style Selector="Window">
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="11" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Bedienelemente eine Spur flacher; die Schriftgröße erben sie vom Fenster. -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- Der Pfad-Zeile in "Sichern" und "Wiederherstellen" gemeinsame Maße geben. -->
    <Style Selector="TextBox.path">
      <Setter Property="FontSize" Value="11.5" />
    </Style>
  </Application.Styles>

</Application>
