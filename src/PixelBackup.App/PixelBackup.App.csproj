<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Konsolenanwendung, damit die Kommandozeile unter Windows sauber
         funktioniert: cmd und PowerShell warten auf das Ende, Ausgabe und
         Rückgabewert kommen an, Umleitungen und Pipes gehen. Beim Start ohne
         Befehl (Doppelklick) blendet Program.Main das Konsolenfenster sofort
         aus, sodass nur das Fenster der Anwendung übrig bleibt. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelBackup.App</RootNamespace>
    <AssemblyName>PixelBackup</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/pixel-backup.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Eigenständige Fassung: die eingebettete .NET-Laufzeit wird in der
         Einzeldatei komprimiert. Das halbiert sie (91 MiB -> 46 MiB); beim
         ersten Start entpackt die Laufzeit sie einmalig in den Zwischenspeicher
         des Benutzers, was rund eine Zehntelsekunde kostet. Wirkt nur bei
         PublishSingleFile in der eigenständigen Fassung; eine
         framework-abhängige Fassung bleibt unberührt. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Keine Debug-Symbole mit ausliefern; das betrifft auch die nativen PDBs
         von SkiaSharp und HarfBuzz, die sonst neben der Datei landen. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />

    <!-- Die Textfassung der Handbuchseite steckt in der Anwendung: so sagt
         der Aufruf mit "manual" unter Windows dasselbe wie "man pixel-backup"
         unter Linux. Erzeugt wird sie mit packaging/man/render.sh. -->
    <EmbeddedResource Include="Cli/pixel-backup.1.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelBackup.Core\PixelBackup.Core.csproj" />
  </ItemGroup>

</Project>
