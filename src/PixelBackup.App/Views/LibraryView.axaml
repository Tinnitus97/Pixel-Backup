<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelBackup.App.Views.LibraryView">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="Sicherungen" Classes="h1" />
      <TextBlock Text="{Binding DiskUsageText}" Classes="hint" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" Margin="0,14,0,0">

      <Border Classes="card" Margin="0,0,12,0">
        <Grid RowDefinitions="*,Auto">
          <ListBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4" Spacing="1">
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Name}" FontSize="12" Classes="hint" />
                  <TextBlock Text="{Binding Summary}" FontSize="12" Classes="hint" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Grid.Row="1" Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,8,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Margin="0">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
        </ScrollViewer>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
      <Border Classes="card" Margin="0" IsVisible="{Binding IsRunning}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Progress.Phase}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Progress.CurrentItem}" Classes="hint" TextTrimming="CharacterEllipsis" />
          <ProgressBar Height="8" Minimum="0" Maximum="100"
                       Value="{Binding Progress.Percent}"
                       IsIndeterminate="{Binding Progress.IsIndeterminate}" />
          <TextBlock Text="{Binding Progress.CountText}" Classes="hint" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
        <Button Content="Sicherung prüfen" Command="{Binding VerifyCommand}" />
        <Button Content="Als ZIP archivieren" Command="{Binding ArchiveCommand}" />
        <Button Content="Löschen" Command="{Binding DeleteCommand}" />
        <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
      </StackPanel>
    </StackPanel>

  </Grid>

</UserControl>
