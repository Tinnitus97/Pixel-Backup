<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelBackup.App.Views.RestoreView">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Classes="hint" Text="{Binding PageHint}" />

      <!-- Speicherort: hier lässt sich auch ein anderer Ordner öffnen -->
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7" Margin="0,7,0,0">
        <TextBlock Grid.Column="0" Text="{Binding LabelSourceFolder}" VerticalAlignment="Center"
                   Classes="hint" MinWidth="74" />
        <TextBox Grid.Column="1" Classes="path" Text="{Binding BackupRoot, Mode=TwoWay}"
                 IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding TipSourceFolder}" />
        <Button Grid.Column="2" Content="{Binding LabelBrowse}" Command="{Binding BrowseSourceCommand}" />
        <Button Grid.Column="3" Content="{Binding LabelOpenFolder}" Command="{Binding OpenSourceCommand}" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="310,*" Margin="0,10,0,0">

      <!-- Liste der Sicherungssätze -->
      <Border Classes="card" Margin="0,0,12,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="{Binding SectionSets}" Classes="h2" Margin="0,0,0,8" />

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Sets}"
                   SelectedItem="{Binding SelectedSet, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4" Spacing="1">
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CreatedText}" FontSize="12" Classes="hint" />
                  <TextBlock Text="{Binding SizeText}" FontSize="12" Classes="hint" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Grid.Row="2" Content="{Binding LabelRefresh}" Command="{Binding RefreshCommand}" Margin="0,8,0,0" />
        </Grid>
      </Border>

      <!-- Details und Gruppen -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Classes="card" Margin="0,0,0,12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding SetDetails}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding LabelConflict}" VerticalAlignment="Center" Classes="hint" />
              <ComboBox ItemsSource="{Binding ConflictOptions}"
                        SelectedItem="{Binding SelectedConflictOption, Mode=TwoWay}"
                        MinWidth="250"
                        IsEnabled="{Binding IsIdle}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <WrapPanel>
              <CheckBox Content="{Binding LabelInstallApps}" Margin="0,0,20,0"
                        IsChecked="{Binding InstallApps, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
              <CheckBox Content="{Binding LabelDowngrade}" Margin="0,0,20,0"
                        IsChecked="{Binding AllowDowngrade, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
              <CheckBox Content="{Binding LabelLegacyAppData}" Margin="0,0,20,0"
                        IsChecked="{Binding RestoreLegacyAppData, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
              <CheckBox Content="{Binding LabelRootAppData}" Margin="0,0,20,0"
                        IsChecked="{Binding RestoreRootAppData, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                        ToolTip.Tip="{Binding TipRootAppData}" />
              <CheckBox Content="{Binding LabelImportFiles}"
                        IsChecked="{Binding PlaceImportFiles, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                        ToolTip.Tip="{Binding TipImportFiles}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card" Margin="0">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <TextBlock Text="{Binding SectionGroups}" Classes="h2" Margin="0" VerticalAlignment="Center" />
              <Button Content="{Binding LabelSelectAll}" Command="{Binding SelectAllCommand}" />
              <Button Content="{Binding LabelSelectNone}" Command="{Binding SelectNoneCommand}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="17" Margin="2,0,10,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding SummaryText}" VerticalAlignment="Center" Classes="hint" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
      <Border Classes="card" Margin="0" IsVisible="{Binding IsRunning}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Progress.Phase}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Progress.CurrentItem}" Classes="hint" TextTrimming="CharacterEllipsis" />
          <ProgressBar Height="8" Minimum="0" Maximum="100"
                       Value="{Binding Progress.Percent}"
                       IsIndeterminate="{Binding Progress.IsIndeterminate}" />
          <Grid ColumnDefinitions="*,*,*,*">
            <TextBlock Grid.Column="0" Text="{Binding Progress.CountText}" Classes="hint" />
            <TextBlock Grid.Column="1" Text="{Binding Progress.BytesText}" Classes="hint" />
            <TextBlock Grid.Column="2" Text="{Binding Progress.SpeedText}" Classes="hint" />
            <TextBlock Grid.Column="3" Text="{Binding Progress.EtaText}" Classes="hint" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResult}" FontWeight="SemiBold" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{Binding LabelStart}" Command="{Binding StartCommand}" Classes="accent" MinWidth="200" />
        <Button Content="{Binding LabelCancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
      </StackPanel>
    </StackPanel>

  </Grid>

</UserControl>
