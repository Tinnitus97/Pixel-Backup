<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelBackup.App.Views.SettingsView">

  <ScrollViewer>
    <StackPanel Spacing="4">

      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{Binding PageHint}" Classes="hint" />

      <Border Classes="card" Margin="0,14,0,12">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SectionAppearance}" Classes="h2" Margin="0,0,0,4" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding LabelLanguage}" VerticalAlignment="Center" MinWidth="120" />
            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      MinWidth="200">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding LanguageDetectedText}" VerticalAlignment="Center" Classes="hint" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding LabelTheme}" VerticalAlignment="Center" MinWidth="120" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      MinWidth="200">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding ThemeDetectedText}" VerticalAlignment="Center" Classes="hint" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SectionPaths}" Classes="h2" Margin="0,0,0,4" />

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding LabelBackupRoot}" Classes="hint" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="520" Text="{Binding BackupRoot, Mode=TwoWay}" />
              <Button Content="{Binding LabelBrowse}" Command="{Binding BrowseBackupRootCommand}" />
              <Button Content="{Binding LabelOpen}" Command="{Binding OpenBackupFolderCommand}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding LabelAdbPath}" Classes="hint" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="520" Watermark="C:\platform-tools\adb.exe" Text="{Binding AdbPath, Mode=TwoWay}" />
              <Button Content="{Binding LabelBrowse}" Command="{Binding BrowseAdbCommand}" />
              <Button Content="{Binding LabelDetectAdb}" Command="{Binding DetectAdbCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding AdbStatusText}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SectionBackup}" Classes="h2" Margin="0,0,0,4" />

          <CheckBox Content="{Binding LabelIncrementalDefault}" IsChecked="{Binding IncrementalByDefault, Mode=TwoWay}" />
          <CheckBox Content="{Binding LabelHashes}" IsChecked="{Binding ComputeHashes, Mode=TwoWay}" />
          <CheckBox Content="{Binding LabelRemoveDeleted}" IsChecked="{Binding RemoveDeletedFiles, Mode=TwoWay}" />
          <CheckBox Content="{Binding LabelArchive}" IsChecked="{Binding CreateArchive, Mode=TwoWay}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding LabelRetention}" VerticalAlignment="Center" />
            <NumericUpDown Width="120"
                           Minimum="0"
                           Maximum="99"
                           Increment="1"
                           FormatString="0"
                           Value="{Binding KeepSetsPerDevice, Mode=TwoWay}" />
            <TextBlock Text="{Binding LabelRetentionUnit}" VerticalAlignment="Center" Classes="hint" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SectionAutomation}" Classes="h2" Margin="0,0,0,4" />

          <CheckBox Content="{Binding LabelWatchDevices}" IsChecked="{Binding WatchDevices, Mode=TwoWay}" />
          <CheckBox Content="{Binding LabelAutoBackup}" IsChecked="{Binding AutoBackupOnConnect, Mode=TwoWay}" />
          <TextBlock Text="{Binding HintAutoBackup}" Classes="hint" FontSize="12" />

          <CheckBox Content="{Binding LabelCheckComponents}" IsChecked="{Binding CheckComponentsOnStart, Mode=TwoWay}" />
          <CheckBox Content="{Binding LabelAutoInstallAdb}" IsChecked="{Binding AutoInstallAdb, Mode=TwoWay}" />
          <CheckBox Content="{Binding LabelCheckUpdates}" IsChecked="{Binding CheckUpdatesOnStart, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding VersionText}" FontSize="12" />
          </StackPanel>
          <TextBlock Text="{Binding HintUpdates}" Classes="hint" FontSize="12" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Content="{Binding LabelSave}" Command="{Binding SaveCommand}" Classes="accent" />
            <Button Content="{Binding LabelOpenSettingsFolder}" Command="{Binding OpenSettingsFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
