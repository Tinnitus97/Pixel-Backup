<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelBackup.App.Views.ComponentsView">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{Binding PageHint}" Classes="hint" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,0">
      <StackPanel>

        <!-- Plattform-Tools -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding Adb.Glyph}"
                       FontSize="26"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding Adb.Name}" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="{Binding Adb.StateText}" Classes="hint" />
              <TextBlock Text="{Binding Adb.Message}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                <TextBlock Text="{Binding LabelVersion}" Classes="hint" FontSize="12" />
                <TextBlock Text="{Binding Adb.VersionText}" FontSize="12" />
                <TextBlock Text="{Binding LabelLocation}" Classes="hint" FontSize="12" />
                <TextBlock Text="{Binding Adb.Location}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="{Binding LabelInstallAdb}"
                    Command="{Binding InstallAdbCommand}"
                    Classes="accent"
                    VerticalAlignment="Center"
                    MinWidth="200" />
          </Grid>
        </Border>

        <!-- USB-Treiber -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding DeviceAccess.Glyph}"
                       FontSize="26"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding DeviceAccess.Name}" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="{Binding DeviceAccess.StateText}" Classes="hint" />
              <TextBlock Text="{Binding DeviceAccess.Message}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0" IsVisible="{Binding ShowVersionOfDeviceAccess}">
                <TextBlock Text="{Binding LabelVersion}" Classes="hint" FontSize="12" />
                <TextBlock Text="{Binding DeviceAccess.VersionText}" FontSize="12" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="{Binding LabelInstallDeviceAccess}"
                    Command="{Binding InstallDeviceAccessCommand}"
                    IsVisible="{Binding CanSetUpDeviceAccess}"
                    VerticalAlignment="Center"
                    MinWidth="200" />
          </Grid>
        </Border>

        <!-- Pixel Backup selbst -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding Application.Glyph}"
                       FontSize="26"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding Application.Name}" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="{Binding Application.StateText}" Classes="hint" />
              <TextBlock Text="{Binding Application.Message}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                <TextBlock Text="{Binding LabelVersion}" Classes="hint" FontSize="12" />
                <TextBlock Text="{Binding Application.VersionText}" FontSize="12" />
                <TextBlock Text="{Binding LabelInstallation}" Classes="hint" FontSize="12" />
                <TextBlock Text="{Binding InstallationKindText}" FontSize="12" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
              <Button Content="{Binding LabelInstallUpdate}"
                      Command="{Binding InstallUpdateCommand}"
                      IsVisible="{Binding HasUpdate}"
                      Classes="accent"
                      MinWidth="200" />
              <Button Content="{Binding LabelReleases}"
                      Command="{Binding OpenReleasesCommand}"
                      IsVisible="{Binding HasUpdate}"
                      MinWidth="200" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
              <TextBlock Text="{Binding LabelSystem}" Classes="hint" FontSize="12" />
              <TextBlock Text="{Binding SystemText}" FontSize="12" />
            </StackPanel>

            <TextBlock Text="{Binding PackageHint}"
                       IsVisible="{Binding HasPackageHint}"
                       Classes="hint"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding SourceHint}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding UpdateSourceHint}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,6">
      <Border Classes="card" Margin="0" IsVisible="{Binding Components.IsBusy}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Components.BusyText}" FontWeight="SemiBold" />
          <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Components.Percent}" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{Binding LabelRefresh}" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding LastCheckText}" VerticalAlignment="Center" Classes="hint" />
      </StackPanel>
    </StackPanel>

  </Grid>

</UserControl>
