<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelBackup.App.Views.DevicesView">

  <ScrollViewer>
    <StackPanel Spacing="4">

      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Classes="hint" Text="{Binding PageHint}" />

      <Border Classes="card" Margin="0,14,0,12">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SectionDevices}" Classes="h2" Margin="0,0,0,4" />

          <ListBox ItemsSource="{Binding Session.Devices}"
                   SelectedItem="{Binding Session.SelectedDevice, Mode=TwoWay}"
                   MaxHeight="190">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Serial}" Classes="hint" FontSize="12" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" Classes="hint" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding LabelRefresh}" Command="{Binding RefreshCommand}" />
            <Button Content="{Binding LabelRestartAdb}" Command="{Binding RestartAdbCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding Session.HasDevice}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SectionInfo}" Classes="h2" Margin="0,0,0,4" />

          <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelModel}" Classes="hint" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Session.DeviceInfo.DisplayName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelAndroid}" Classes="hint" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Session.DeviceInfo.AndroidText}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelBuild}" Classes="hint" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Session.DeviceInfo.BuildId}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LabelPatch}" Classes="hint" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Session.DeviceInfo.SecurityPatch}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding LabelStorage}" Classes="hint" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Session.DeviceInfo.StorageText}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding LabelSerial}" Classes="hint" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Session.DeviceInfo.Serial}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding LabelRoot}" Classes="hint" />
            <TextBlock Grid.Row="6" Grid.Column="1"
                       Text="{Binding Session.DeviceInfo.RootText}"
                       TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SectionWireless}" Classes="h2" Margin="0,0,0,4" />
          <TextBlock Classes="hint" Text="{Binding WirelessHint}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="240"
                     Watermark="192.168.1.50:5555"
                     Text="{Binding WirelessAddress, Mode=TwoWay}" />
            <Button Content="{Binding LabelConnect}" Command="{Binding ConnectWirelessCommand}" />
            <Button Content="{Binding LabelEnableWireless}" Command="{Binding EnableWirelessCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SectionFirstSteps}" Classes="h2" Margin="0,0,0,4" />
          <TextBlock Text="{Binding SetupHint}" Classes="hint" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
