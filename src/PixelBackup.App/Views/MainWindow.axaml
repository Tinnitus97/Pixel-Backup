<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelBackup.App.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/pixel-backup.ico"
        Width="1180"
        Height="720"
        MinWidth="940"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Kopfzeile: Gerätestatus links, Bedienung rechts -->
    <Border Grid.Row="0" Padding="14,9" Background="{DynamicResource CardBackgroundBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="📱" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding DeviceHeadline}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DeviceSubline}" Classes="hint" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <!-- Der Fortschritt steht auf der jeweiligen Seite; die Kopfzeile bleibt ruhig. -->
          <Button Content="{Binding LabelFindDevices}" Command="{Binding RefreshDevicesCommand}" />

          <!-- Sprache und Erscheinungsbild ohne Umweg über die Einstellungen -->
          <ComboBox ItemsSource="{Binding Languages}"
                    SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                    ToolTip.Tip="{Binding LanguageTooltip}"
                    Width="112"
                    VerticalAlignment="Center" />
          <Button Content="{Binding ThemeIcon}"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="{Binding ThemeTooltip}"
                  FontSize="15"
                  Width="38"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Hinweisband zur neuen Fassung. Es steht über allen Seiten, damit die
         Meldung nicht auf der Seite „Komponenten“ vergraben bleibt, und
         verschwindet wieder, sobald es nichts zu melden gibt oder der Hinweis
         weggeklickt wurde. Geladen wird nichts ohne Rückfrage. -->
    <Border Grid.Row="1"
            Classes="warning"
            Margin="14,9,14,0"
            IsVisible="{Binding ShowUpdateBanner}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="⬆"
                   FontSize="17"
                   Margin="2,0,11,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource WarningTextBrush}" />

        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding UpdateHeadline}" Classes="warningText" FontWeight="SemiBold" />
          <TextBlock Text="{Binding UpdateSubline}" Classes="warningText" FontSize="11.5" Opacity="0.85" />
        </StackPanel>

        <Button Grid.Column="2"
                Content="{Binding LabelUpdateNotes}"
                Command="{Binding OpenReleasesCommand}"
                Margin="10,0,0,0" />
        <Button Grid.Column="3"
                Content="{Binding LabelInstallUpdate}"
                Command="{Binding InstallUpdateCommand}"
                IsVisible="{Binding CanInstallUpdate}"
                Classes="accent"
                Margin="6,0,0,0"
                MinWidth="150" />
        <Button Grid.Column="4"
                Content="✕"
                Command="{Binding DismissUpdateCommand}"
                ToolTip.Tip="{Binding LabelDismissUpdate}"
                Margin="6,0,0,0"
                Width="32"
                HorizontalContentAlignment="Center" />
      </Grid>
    </Border>

    <!-- Navigation und Inhalt -->
    <Grid Grid.Row="2" ColumnDefinitions="184,*">
      <ListBox Grid.Column="0"
               ItemsSource="{Binding Pages}"
               SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
               Background="Transparent"
               Padding="8">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="2,3">
              <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ContentControl Grid.Column="1" Content="{Binding SelectedPage}" Margin="14,10,14,2" />
    </Grid>

    <!-- Statusleiste -->
    <Border Grid.Row="3" Padding="14,6" Background="{DynamicResource CardBackgroundBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding SelectedPage.StatusMessage}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding AdbStatus}" Classes="hint" TextTrimming="CharacterEllipsis" MaxWidth="460" />
      </Grid>
    </Border>

  </Grid>

</Window>
