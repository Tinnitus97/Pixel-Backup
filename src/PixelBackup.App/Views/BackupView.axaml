<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelBackup.App.Views.BackupView">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Classes="hint" Text="{Binding PageHint}" />
      <TextBlock Text="{Binding TargetDescription}" Classes="hint" Margin="0,6,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Margin="0,10,0,8">
      <StackPanel Spacing="8">

        <!-- Speicherort: dieselbe Angabe wie in den Einstellungen, hier griffbereit -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
          <TextBlock Grid.Column="0" Text="{Binding LabelTargetFolder}" VerticalAlignment="Center"
                     Classes="hint" MinWidth="74" />
          <TextBox Grid.Column="1" Classes="path" Text="{Binding BackupRoot, Mode=TwoWay}"
                   IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding TipTargetFolder}" />
          <Button Grid.Column="2" Content="{Binding LabelBrowse}" Command="{Binding BrowseTargetCommand}" />
          <Button Grid.Column="3" Content="{Binding LabelOpenFolder}" Command="{Binding OpenTargetCommand}" />
        </Grid>

        <WrapPanel>
          <CheckBox Content="{Binding LabelIncremental}" Margin="0,0,20,0"
                    IsChecked="{Binding Incremental, Mode=TwoWay}"
                    IsEnabled="{Binding IsIdle}"
                    ToolTip.Tip="{Binding TipIncremental}" />
          <CheckBox Content="{Binding LabelHashes}" Margin="0,0,20,0"
                    IsChecked="{Binding ComputeHashes, Mode=TwoWay}"
                    IsEnabled="{Binding IsIdle}"
                    ToolTip.Tip="{Binding TipHashes}" />
          <CheckBox Content="{Binding LabelRemoveDeleted}" Margin="0,0,20,0"
                    IsChecked="{Binding RemoveDeletedFiles, Mode=TwoWay}"
                    IsEnabled="{Binding IsIdle}"
                    ToolTip.Tip="{Binding TipRemoveDeleted}" />
          <CheckBox Content="{Binding LabelArchive}"
                    IsChecked="{Binding CreateArchive, Mode=TwoWay}"
                    IsEnabled="{Binding IsIdle}" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CreateArchive}">
          <TextBlock Text="{Binding LabelArchivePassword}" VerticalAlignment="Center" Classes="hint" />
          <TextBox Width="220" PasswordChar="•" Text="{Binding ArchivePassword, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
          <TextBlock Text="{Binding HintArchivePassword}" VerticalAlignment="Center" Classes="hint" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding LabelSelectAll}" Command="{Binding SelectAllCommand}" IsEnabled="{Binding IsIdle}" />
          <Button Content="{Binding LabelSelectNone}" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding IsIdle}" />
          <Button Content="{Binding LabelSelectRecommended}" Command="{Binding SelectRecommendedCommand}" IsEnabled="{Binding IsIdle}" />
          <TextBlock Text="{Binding PlanSummary}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,6"
                    Padding="12,10"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsAvailable}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="19" Margin="2,0,12,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Classes="hint" FontSize="12" />
                  <TextBlock Text="{Binding NoteText}"
                             IsVisible="{Binding HasNote}"
                             Foreground="#C58A1E"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="{Binding SummaryText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Classes="hint" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="10" Margin="0,12,0,0">

      <Border Classes="card" Margin="0" IsVisible="{Binding IsRunning}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Progress.Phase}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Progress.CurrentItem}" Classes="hint" TextTrimming="CharacterEllipsis" />

          <!-- Oben die laufende Gruppe, unten der ganze Lauf -->
          <Grid ColumnDefinitions="54,*,44" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="5">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Progress.LabelCurrent}"
                       Classes="hint" VerticalAlignment="Center" />
            <ProgressBar Grid.Row="0" Grid.Column="1"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress.CurrentPercent}"
                         IsIndeterminate="{Binding Progress.CurrentIsIndeterminate}"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Progress.CurrentPercentText}"
                       Classes="hint" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Progress.LabelTotal}"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <ProgressBar Grid.Row="1" Grid.Column="1"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress.Percent}"
                         IsIndeterminate="{Binding Progress.IsIndeterminate}"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Progress.PercentText}"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*">
            <TextBlock Grid.Column="0" Text="{Binding Progress.CountText}" Classes="hint" />
            <TextBlock Grid.Column="1" Text="{Binding Progress.BytesText}" Classes="hint" />
            <TextBlock Grid.Column="2" Text="{Binding Progress.SpeedText}" Classes="hint" />
            <TextBlock Grid.Column="3" Text="{Binding Progress.EtaText}" Classes="hint" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResult}" FontWeight="SemiBold" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{Binding LabelAnalyze}" Command="{Binding AnalyzeCommand}" />
        <Button Content="{Binding LabelStart}"
                Command="{Binding StartCommand}"
                Classes="accent"
                MinWidth="170" />
        <Button Content="{Binding LabelCancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
      </StackPanel>

    </StackPanel>

  </Grid>

</UserControl>
